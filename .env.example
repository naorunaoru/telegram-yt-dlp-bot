TELEGRAM_BOT_TOKEN=your_token
VERBOSE_GROUPS=false

# Downloader auto-update configuration
DOWNLOADERS_AUTO_UPDATE=true
# Backward-compatible aliases also work:
# YTDLP_AUTO_UPDATE=true
#
# Cron schedule for downloader updates (default: every 24 hours at minute 0)
# Format: minute hour day month weekday
# Examples:
#   0 */24 * * *  - Every 24 hours at minute 0
#   0 3 * * *     - Daily at 3:00 AM
#   0 */12 * * *  - Every 12 hours
DOWNLOADERS_UPDATE_CRON=0 */24 * * *
# Backward-compatible alias also works:
# YTDLP_UPDATE_CRON=0 */24 * * *

# Optional Netscape-format cookies file. Mount this file read-only in Docker and
# point the env var at the in-container path. Used by both yt-dlp and gallery-dl.
DOWNLOADER_COOKIES_FILE=
# Per-tool overrides, useful if you split cookies by downloader.
YTDLP_COOKIES_FILE=
GDL_COOKIES_FILE=
# Local-only convenience for yt-dlp. Usually not useful inside Docker unless the
# browser profile is mounted and unlockable in the container.
YTDLP_COOKIES_FROM_BROWSER=

# Cache configuration
# Path to SQLite cache database
CACHE_DB_PATH=./data/cache.db
# Maximum number of cached entries (oldest evicted when exceeded)
CACHE_MAX_ENTRIES=100000
# Run eviction check every N cache writes (default: 100)
CACHE_EVICT_WRITES=100

# Optional Reddit OAuth overrides passed to gallery-dl at runtime
# When GDL_REDDIT_REFRESH_TOKEN is set, the bot automatically enables
# extractor.reddit.api=oauth unless GDL_REDDIT_API is set explicitly.
GDL_REDDIT_API=
GDL_REDDIT_REFRESH_TOKEN=
GDL_REDDIT_USER_AGENT=
